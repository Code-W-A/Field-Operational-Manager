# Identitatea staging se completează numai după provisioning și aprobare.
APP_DEPLOYMENT_ENV=staging
NEXT_PUBLIC_APP_ENV=staging
STAGING_MARKER=true
VERCEL_ENV=preview

FIREBASE_DEPLOY_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=
NEXT_PUBLIC_FUNCTIONS_BASE_URL=
NEXT_PUBLIC_APP_URL=

# Staging rămâne disabled până la aprobarea unui sink cu domenii izolate.
MAIL_TRANSPORT_MODE=disabled
MAIL_SINK_ALLOWED_DOMAINS=
REVERSE_GEOCODE_MODE=disabled
NEXT_PUBLIC_E2E_ENABLED=false

PRODUCTION_FIREBASE_PROJECT_DENYLIST=field-operational-manager
PRODUCTION_APP_HOST_DENYLIST=fom-nrg.vercel.app
STAGING_FIREBASE_PROJECT_ALLOWLIST=
STAGING_APPROVED_COMMIT=
STAGING_REQUIRE_CLEAN_WORKTREE=true
