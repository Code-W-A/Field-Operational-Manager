# Copiază valorile în .env.local (nu comite .env.local).
# DSN: Sentry → Project Settings → Client Keys (DSN)

NEXT_PUBLIC_SENTRY_DSN=

# Build / CI — upload source maps (nu comite token-ul; setare în Vercel / CI).
# next.config.mjs citește SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=popescu-pompiliu-ion-pfa
# SENTRY_PROJECT=fom-nextjs

# Org/project au și valori implicite în next.config.mjs dacă nu sunt setate.
