rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdminOrDispatcher() {
      return isSignedIn() && (userRole() == 'admin' || userRole() == 'dispecer');
    }

    function isStaffInternal() {
      return isSignedIn() && (userRole() == 'admin' || userRole() == 'dispecer' || userRole() == 'tehnician');
    }

    function isAdminOnlyRole() {
      return isSignedIn() && userRole() == 'admin';
    }

    /** Proceduri (colecția note-interne): vizualizare pentru orice rol în afară de client portal. */
    function canReadProceduresCollection() {
      return isSignedIn() && userRole() != 'client';
    }

    function isHrCollection() {
      // First segment after /documents/
      return request.path.segments.size() > 0 &&
        (request.path.segments[0] == 'hrEmployees' ||
         request.path.segments[0] == 'hrTimesheets' ||
         request.path.segments[0] == 'hrRequests');
    }

    function isTechnicianGroupsCollection() {
      return request.path.segments.size() > 0 &&
        request.path.segments[0] == 'technician_groups';
    }

    function isCrmCollection() {
      return request.path.segments.size() > 0 &&
        (request.path.segments[0] == 'crm_clients' ||
         request.path.segments[0] == 'crm_client_contacts' ||
         request.path.segments[0] == 'crm_opportunities' ||
         request.path.segments[0] == 'crm_opportunity_contacts' ||
         request.path.segments[0] == 'crm_opportunity_access' ||
         request.path.segments[0] == 'crm_offers' ||
         request.path.segments[0] == 'crm_tasks' ||
         request.path.segments[0] == 'crm_notes' ||
         request.path.segments[0] == 'crm_internal_notes' ||
         request.path.segments[0] == 'crm_internal_threads' ||
         request.path.segments[0] == 'crm_internal_handoffs' ||
         request.path.segments[0] == 'crm_files' ||
         request.path.segments[0] == 'crm_emails' ||
         request.path.segments[0] == 'crm_calendar_events' ||
         request.path.segments[0] == 'crm_activity_logs' ||
         request.path.segments[0] == 'crm_visible_to' ||
         request.path.segments[0] == 'crm_counters');
    }

    // HR: restrict to admin + dispecer
    match /hrEmployees/{employeeId} {
      // Admin/dispatcher: full access.
      allow read, write: if isAdminOrDispatcher();
      // Employee can read own HR profile (needed for technician requests routing).
      allow read: if isSignedIn() && resource.data.userUid == request.auth.uid;
    }

    match /hrTimesheets/{timesheetId} {
      allow read, write: if isAdminOrDispatcher();
    }

    match /hrRequests/{requestId} {
      // Create: only requester can create for themselves.
      allow create: if isSignedIn() && request.resource.data.requesterUid == request.auth.uid;

      // Read: requester OR manager OR admin/dispatcher.
      allow read: if isAdminOrDispatcher()
        || (isSignedIn() && resource.data.requesterUid == request.auth.uid)
        || (isSignedIn() && resource.data.managerUid == request.auth.uid);

      // Update: manager OR admin/dispatcher (requester edits can be added later).
      allow update: if isAdminOrDispatcher()
        || (isSignedIn() && resource.data.managerUid == request.auth.uid);

      // Delete: only pending requests can be hard-deleted, by manager or admin/dispatcher.
      allow delete: if resource.data.status == 'pending' && (
        isAdminOrDispatcher()
        || (isSignedIn() && resource.data.managerUid == request.auth.uid)
      );
    }

    // CRM collections: access for internal staff (admin/dispecer/tehnician).
    match /crm_clients/{docId} {
      allow read, write: if isStaffInternal();
    }

    match /crm_client_contacts/{docId} {
      allow read, write: if isStaffInternal();
    }

    match /crm_opportunities/{docId} {
      allow read, write: if isStaffInternal();
    }

    match /crm_opportunity_contacts/{docId} {
      allow read, write: if isStaffInternal();
    }

    match /crm_opportunity_access/{docId} {
      allow read, write: if isStaffInternal();
    }

    match /crm_offers/{docId} {
      allow read, write: if isStaffInternal();
    }

    match /crm_tasks/{docId} {
      allow read, write: if isStaffInternal();
    }

    match /crm_notes/{docId} {
      allow read, write: if isStaffInternal();
    }

    match /crm_internal_notes/{docId} {
      allow read, write: if isStaffInternal();
    }

    match /crm_internal_threads/{threadId} {
      allow read, write: if isStaffInternal();

      match /messages/{messageId} {
        allow read, write: if isStaffInternal();
      }
    }

    match /crm_internal_handoffs/{docId} {
      allow read, write: if isStaffInternal();
    }

    match /crm_files/{docId} {
      allow read, write: if isStaffInternal();
    }

    match /crm_emails/{docId} {
      allow read, write: if isStaffInternal();
    }

    match /crm_calendar_events/{docId} {
      allow read, write: if isStaffInternal();
    }

    match /crm_activity_logs/{docId} {
      allow read, write: if isStaffInternal();
    }

    match /crm_visible_to/{docId} {
      allow read, write: if isStaffInternal();
    }

    match /crm_counters/{docId} {
      allow read, write: if isStaffInternal();
    }

    // Proceduri operaționale (UI: /dashboard/note-interne)
    match /note-interne/{docId} {
      allow read: if canReadProceduresCollection();
      allow create, update, delete: if isAdminOnlyRole();
    }

    // Grupuri tehnicieni: dispecer citește (select grupat la tichet); doar admin CRUD
    match /technician_groups/{groupId} {
      allow read: if isAdminOrDispatcher();
      allow create, update, delete: if isAdminOnlyRole();
    }

    // Fallback (existing app behavior): allow authenticated access.
    // NOTE: this is intentionally broad to avoid breaking existing collections in this repo.
    match /{document=**} {
      // Keep broad access for legacy collections, but exclude HR collections which have explicit rules above.
      allow read, write: if isSignedIn() && !isHrCollection() && !isCrmCollection() && !isTechnicianGroupsCollection();
    }
  }
}
