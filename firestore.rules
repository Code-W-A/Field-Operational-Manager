rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function catalogDocument(documentId, data) {
      return documentId == 'mobile-offline-phase2' || documentId.matches('^equipment-(manufacturers|models)(-.*)?$')
        || data.get('parentId', '') in ['equipment-manufacturers', 'equipment-models'];
    }
    function serverOnlyCollection(name) {
      return name == 'mobileDrafts' || name in ['mobileOfflineGrants', 'mobileOfflineWork', 'mobileDraftAccess', 'revisionPhotoDeletions', 'mobilePushDevices', 'mobileNotifications', 'mobileNotificationDeliveries', 'mobileNotificationHeads', 'mobileTicketNotificationSchedules', 'mobileTermsAcceptances', 'installationTechnicianSessions', 'installationCommands', 'mobileCommands', 'mobileFiles', 'mobileEffects', 'trackingPoints', 'trackingLatest', 'crm_command_receipts', 'crm_equipment_uploads'];
    }
    function draftOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'tehnician';
    }
    function draftAccess(uid, workId) {
      let grant = get(/databases/$(database)/documents/mobileDraftAccess/$(uid)).data;
      let attendance = get(/databases/$(database)/documents/attendance/$(grant.sessionId)).data;
      let work = get(/databases/$(database)/documents/lucrari/$(workId)).data;
      return draftOwner(uid) && request.time.toMillis() < grant.expiresAt
        && workId in grant.workIds && attendance.userId == uid && attendance.status == 'active'
        && attendance.get('sessionEnd', null) == null
        && (uid in work.get('technicianIds', [])
          || get(/databases/$(database)/documents/users/$(uid)).data.displayName in work.get('tehnicieni', []));
    }
    function draftPhoto(p, prefix) {
      let id = p.id;
      let name = p.name;
      let size = p.size;
      return p.keys().hasOnly(['id','path','name','contentType','size'])
        && id.matches('^[a-zA-Z0-9_-]{8,120}$')
        && p.path == prefix + id
        && name is string && name.size() <= 200
        && p.contentType in ['image/jpeg','image/png'] && size is int && size > 0 && size <= 3000000;
    }
    function draftText(value, limit) {
      return value is string && value.size() <= limit;
    }
    function draftContent(d) {
      let c = d.content;
      return c is map && (
        (d.kind == 'installation' && c.keys().hasOnly(['finding','operations','installationStatus','blockReason','internalNote','beneficiaryName','technicianPaths','beneficiaryPaths','signatureSnapshot'])
          && (draftText(c.get('finding',''), 12000))
          && (draftText(c.get('operations',''), 12000))
          && (draftText(c.get('installationStatus',''), 12000))
          && (draftText(c.get('blockReason',''), 12000))
          && (draftText(c.get('internalNote',''), 12000))
          && (draftText(c.get('beneficiaryName',''), 12000))
          && (draftText(c.get('technicianPaths',''), 60000) && draftText(c.get('beneficiaryPaths',''), 60000) && draftText(c.get('signatureSnapshot',''), 180000))
        )
        || (d.kind == 'completion' && c.keys().hasOnly(['observations','beneficiaryName','technicianPaths','beneficiaryPaths','signatureSnapshot'])
          && (draftText(c.get('observations',''), 12000))
          && (draftText(c.get('beneficiaryName',''), 12000))
          && (draftText(c.get('technicianPaths',''), 60000) && draftText(c.get('beneficiaryPaths',''), 60000) && draftText(c.get('signatureSnapshot',''), 180000))
        )
        || (d.kind == 'revision' && c.keys().hasOnly(['finalObservations','sections','photos'])
          && (draftText(c.get('finalObservations',''), 12000))
          && c.get('sections', []) is list && c.get('sections', []).size() <= 100
          && c.get('photos', []) is list && c.get('photos', []).size() <= 4
        )
        || (d.kind == 'intervention' && c.keys().hasOnly(['constatareLaLocatie','descriereInterventie','statusEchipament','cauzaPrincipalaDefectId','tehnicianGarantieDecizie','tehnicianGarantieNuIntraMotiv','comentariiOferta','notaInternaTehnician','numeBeneficiar','manualEmails','necesitaOferta','products','useManualRecipients','imaginiDefecte','technicianPaths','beneficiaryPaths','signatureSnapshot'])
          && (draftText(c.get('constatareLaLocatie',''), 12000))
          && (draftText(c.get('descriereInterventie',''), 12000))
          && (draftText(c.get('statusEchipament',''), 12000))
          && (draftText(c.get('cauzaPrincipalaDefectId',''), 12000))
          && (draftText(c.get('tehnicianGarantieDecizie',''), 12000))
          && (draftText(c.get('tehnicianGarantieNuIntraMotiv',''), 12000))
          && (draftText(c.get('comentariiOferta',''), 12000))
          && (draftText(c.get('notaInternaTehnician',''), 12000))
          && (draftText(c.get('numeBeneficiar',''), 12000))
          && (draftText(c.get('manualEmails',''), 12000))
          && (draftText(c.get('technicianPaths',''), 60000) && draftText(c.get('beneficiaryPaths',''), 60000) && draftText(c.get('signatureSnapshot',''), 180000))
          && c.get('necesitaOferta', false) is bool
          && c.get('products', []) is list && c.get('products', []).size() <= 100
          && c.get('useManualRecipients', false) is bool
          && c.get('imaginiDefecte', []) is list && c.get('imaginiDefecte', []).size() <= 4
        )
      );
    }
    function validDraft(d,uid) {
      let prefix = 'mobile-drafts/' + uid + '/' + d.draftId + '/';
      let photos = d.photos;
      let count = photos.size();
      return d.keys().hasOnly(['schemaVersion','ownerUid','draftId','key','workId','targetId','kind','baseVersion','sheetRevision','localRevision','saveId','deviceId','expectedHead','content','photos','accepted','savedAt'])
        && d.schemaVersion == 1 && d.ownerUid == uid
        && d.workId.matches('^[a-zA-Z0-9_-]{1,160}$')
        // Exact kind-specific identities below enforce string types and lengths.
        && d.saveId.matches('^[a-zA-Z0-9_-]{8,120}$') && d.deviceId.matches('^[a-zA-Z0-9_-]{8,120}$')
        && (d.baseVersion == null || (d.baseVersion is string && d.baseVersion.size() <= 200))
        && (d.sheetRevision == null || d.sheetRevision is int)
        && ((d.kind == 'completion' && d.targetId == '' && d.key == d.workId + ':completion' && d.draftId == d.workId + '~completion')
          || (d.kind == 'intervention' && d.targetId == '' && d.key == d.workId && d.draftId == d.workId)
          || (d.kind == 'revision' && d.targetId.matches('^[a-zA-Z0-9_-]{1,160}$') && d.key == d.workId + ':revision:' + d.targetId && d.draftId == d.workId + '~revision~' + d.targetId)
          || (d.kind == 'installation' && d.targetId.matches('^[a-zA-Z0-9_-]{1,160}$') && d.key == d.workId + ':sheet:' + d.targetId && d.draftId == d.workId + '~sheet~' + d.targetId))
        && d.localRevision is int && d.localRevision > 0 && d.accepted is bool && d.savedAt is number
        && (d.expectedHead == null || d.expectedHead is string)
        && photos is list && count <= 4
        && (count < 1 || draftPhoto(photos[0],prefix))
        && (count < 2 || draftPhoto(photos[1],prefix))
        && (count < 3 || draftPhoto(photos[2],prefix))
        && (count < 4 || draftPhoto(photos[3],prefix))
        && draftContent(d);
    }
    match /mobileDraftAccess/{uid} { allow read: if draftOwner(uid); }
    match /mobileDrafts/{uid}/heads/{draftId} {
      allow read: if draftOwner(uid);
      // A head may only point to a NEW immutable save in the same transaction.
      // Its create rule checks owner, active access and every field once; exact
      // equality prevents substituting data or reusing a historical save.
      allow create, update: if !exists(/databases/$(database)/documents/mobileDrafts/$(uid)/saves/$(request.resource.data.saveId))
        && request.resource.data.draftId == draftId
        && request.resource.data.accepted == true
        && getAfter(/databases/$(database)/documents/mobileDrafts/$(uid)/saves/$(request.resource.data.saveId)).data == request.resource.data
        && ((!exists(/databases/$(database)/documents/mobileDrafts/$(uid)/heads/$(draftId)) && request.resource.data.expectedHead == null)
          || (exists(/databases/$(database)/documents/mobileDrafts/$(uid)/heads/$(draftId)) && resource.data.saveId == request.resource.data.expectedHead));
      allow delete: if draftOwner(uid);
    }
    match /mobileDrafts/{uid}/saves/{saveId} {
      allow read, delete: if draftOwner(uid);
      allow create: if draftAccess(uid,request.resource.data.workId)
        && validDraft(request.resource.data,uid) && request.resource.data.saveId == saveId
        && (request.resource.data.accepted == false
          || getAfter(/databases/$(database)/documents/mobileDrafts/$(uid)/heads/$(request.resource.data.draftId)).data.saveId == saveId);
    }
    match /mobileDrafts/{uid}/files/{fileId} {
      allow read: if draftOwner(uid);
      allow create, update: if draftOwner(uid)
        && request.resource.data.keys().hasOnly(['path','draftId','refs','deleting'])
        && request.resource.data.path == 'mobile-drafts/' + uid + '/' + request.resource.data.draftId + '/' + fileId
        && request.resource.data.refs is list && request.resource.data.refs.size() <= 200
        && request.resource.data.deleting is bool;
      allow delete: if draftOwner(uid) && resource.data.deleting && resource.data.refs.size() == 0;
    }
    // Preserve legacy access while routing the new installation data through verified server APIs.
    // Do not add an overlapping unrestricted recursive wildcard: it would override these exclusions.
    match /{collectionName}/{documentId} {
      allow read: if !serverOnlyCollection(collectionName);
      allow create: if !serverOnlyCollection(collectionName)
        && (collectionName != 'settings' || !catalogDocument(documentId, request.resource.data) || isAdmin())
        && (collectionName != 'users' || isAdmin())
        && (collectionName != 'lucrari' || !request.resource.data.keys().hasAny(['installation']));
      allow update: if !serverOnlyCollection(collectionName)
        && (collectionName != 'settings' || (!catalogDocument(documentId, resource.data) && !catalogDocument(documentId, request.resource.data)) || isAdmin())
        && (collectionName != 'users' || isAdmin()
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'displayName', 'uid']))
        && (collectionName != 'lucrari' || (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['installation'])
          && (!resource.data.keys().hasAny(['installation'])
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'tipLucrare', 'equipmentIds', 'echipamentId', 'echipamentCod', 'echipament',
              'clientId', 'locationId', 'client', 'locatie', 'clientInfo', 'tehnicieni',
              'statusLucrare', 'anulat', 'anulatAt', 'archivedAt', 'archived',
              'raportSnapshot', 'raportGenerat', 'semnaturaTehnician', 'semnaturaBeneficiar'
            ]))
        ));
      allow delete: if !serverOnlyCollection(collectionName)
        && (collectionName != 'settings' || !catalogDocument(documentId, resource.data) || isAdmin())
        && (collectionName != 'users' || isAdmin())
        && (collectionName != 'lucrari' || !resource.data.keys().hasAny(['installation']));
    }
    match /{collectionName}/{documentId}/{subcollection}/{rest=**} {
      allow read: if !serverOnlyCollection(collectionName)
        && (collectionName != 'lucrari' || !(subcollection in ['installationSheets', 'installationCompletion', 'installationAudit']));
      allow write: if !serverOnlyCollection(collectionName)
        && (collectionName != 'settings' || (!documentId.matches('^equipment-(manufacturers|models)(-.*)?$') && (!exists(/databases/$(database)/documents/settings/$(documentId)) || !catalogDocument(documentId, get(/databases/$(database)/documents/settings/$(documentId)).data))) || isAdmin())
        && (collectionName != 'lucrari' || !(subcollection in [
          'installationSheets', 'installationCompletion', 'installationAudit'
        ]));
    }
  }
}
